# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
**/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.local.tpl

# vercel
.vercel

# local-only dev scripts (never commit)
scripts/**/*.local.mjs

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright
/test-results
/playwright-report
/blob-report
/playwright/.cache

# git worktrees
/.worktrees
android-native/.kotlin/

# Instruments traces (local profiling artefacts)
ios-native/*.trace
ios-native/build/
ios-native/build_device/
ios-native/build_sim/
ios-native/DerivedData/
ios-native/Packages/*/.build/

# temp scripts (do not commit)
tmp-*.mjs
.env.prod-cleanup

# transient dir (clerk CLI key pulls land here in sandboxed runs — never commit)
tmp/

# stream backup directories (never commit)
*-backup/
.worktrees/

# ShipStudio metadata
.shipstudio/

# iOS build outputs, SwiftPM, Instruments
ios-native/build*/
**/.build/
xcuserdata/
*.xcuserstate

# scan outputs
gitleaks*.json
