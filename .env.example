# Database
# DATABASE_URL = runtime queries (non-superuser, RLS-enforced)
# DIRECT_URL  = migrations only (superuser, used by `prisma migrate`)
DATABASE_URL="postgresql://canalog_app:canalog_app_dev_password@localhost:5432/canalog_dev?schema=public"
DIRECT_URL="postgresql://canalog:canalog_dev_password@localhost:5432/canalog_dev?schema=public"

# Clerk (get from https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
CLERK_WEBHOOK_SIGNING_SECRET=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/dashboard"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Enable browser-like tab shell (desktop). Defaults to 0 (disabled).
NEXT_PUBLIC_ENABLE_TABS=0
