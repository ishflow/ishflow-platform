generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [pgcrypto]
}

enum TenantPlan {
  free
  starter
  pro
  business
  enterprise
}

enum TenantStatus {
  active
  trialing
  past_due
  suspended
  cancelled
  deleted
}

enum ScopeOperator {
  equals
  in_
  contextEquals
  currentUser
}

enum ApiKeyScope {
  read
  write
  platform_admin

  @@map("api_key_scope")
}

model Tenant {
  id                   String       @id @default(uuid()) @db.Uuid
  clerkOrgId           String       @unique @map("clerk_org_id")
  name                 String
  slug                 String       @unique
  plan                 TenantPlan   @default(free)
  status               TenantStatus @default(trialing)
  currency             String       @default("USD")
  defaultLocale        String       @default("ru") @map("default_locale")
  defaultMarkupPct     Decimal      @default(0.10) @map("default_markup_pct") @db.Decimal(5, 4)
  mobileFeatures       Json?        @map("mobile_features")
  notificationSettings Json?        @map("notification_settings")
  stripeCustomerId     String?      @unique @map("stripe_customer_id")
  stripeSubscriptionId String?      @unique @map("stripe_subscription_id")
  legalName            String?      @map("legal_name")
  logoUrl              String?      @map("logo_url")
  brandColor           String?      @map("brand_color")
  archivedBy           String?      @map("archived_by") @db.Uuid
  trialEndsAt          DateTime?    @map("trial_ends_at")
  demoImportedAt       DateTime?    @map("demo_imported_at")
  onboardingState      Json?        @map("onboarding_state")
  lastActivityAt       DateTime?    @map("last_activity_at")
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")
  deletedAt            DateTime?    @map("deleted_at")

  memberships          Membership[]
  auditLogs            AuditLog[]
  roles                Role[]
  savedViews           SavedView[]
  attachments          Attachment[]
  periodCloses         PeriodClose[]
  idempotencyKeys      IdempotencyKey[]
  devicePushTokens     DevicePushToken[]
  billingEvents        BillingEvent[]
  planLimitOverrides   PlanLimitOverride[]
  apiKeys              ApiKey[]
  tenantAddons         TenantAddon[]
  ocrJobs              PurchaseInvoiceOcrJob[]
  bankAccounts         BankAccount[]
  bankStatementImports BankStatementImport[]
  bankStatementRows    BankStatementRow[]
  tags                 TenantTag[]
  notes                TenantNote[]
  suspension           TenantSuspension?
  featureKills         TenantFeatureKill[]
  priceOverride        TenantPriceOverride?
  settings             TenantSettings[]

  @@map("tenant")
}

model User {
  id        String    @id @default(uuid()) @db.Uuid
  clerkId   String    @unique @map("clerk_id")
  email     String    @unique
  firstName String?   @map("first_name")
  lastName  String?   @map("last_name")
  imageUrl  String?   @map("image_url")
  phone     String?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  memberships      Membership[]
  auditLogs        AuditLog[]
  savedViews       SavedView[]
  attachments      Attachment[]
  closedPeriods    PeriodClose[]     @relation("PeriodCloseClosedBy")
  devicePushTokens DevicePushToken[]
  apiKeysCreated   ApiKey[]          @relation("ApiKeyCreatedBy")
  settings         UserSettings[]

  @@map("user")
}

model Membership {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roles     Role[]   @relation("MembershipRoles")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([userId])
  @@map("membership")
}

model TenantSettings {
  tenantId  String   @map("tenant_id") @db.Uuid
  key       String
  payload   Json     @default("{}") @db.JsonB
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, key])
  @@map("tenant_settings")
}

model UserSettings {
  userId    String   @map("user_id") @db.Uuid
  key       String
  payload   Json     @default("{}") @db.JsonB
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, key])
  @@map("user_settings")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  entity    String
  entityId  String   @map("entity_id")
  action    String
  before    Json?
  after     Json?
  source    String?  @db.VarChar(16)
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([entity, entityId])
  @@map("audit_log")
}

model DocumentSequence {
  tenantId String @map("tenant_id") @db.Uuid
  docType  String @map("doc_type")
  prefix   String
  next     Int    @default(1)

  @@id([tenantId, docType])
  @@map("document_sequence")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  name        String
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  permissions String[] @default([])
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  scopes      RoleScope[]
  memberships Membership[] @relation("MembershipRoles")

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([permissions], type: Gin)
  @@map("role")
}

model RoleScope {
  id        String        @id @default(uuid()) @db.Uuid
  roleId    String        @map("role_id") @db.Uuid
  entityId  String        @map("entity_id")
  field     String
  operator  ScopeOperator
  value     Json
  isSystem  Boolean       @default(false)
  createdAt DateTime      @default(now()) @map("created_at")

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@index([roleId])
  @@index([entityId])
  @@map("role_scope")
}

model SavedView {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  kind      String
  name      String
  payload   Json
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, kind, name])
  @@index([tenantId, userId, kind])
  @@index([tenantId, deletedAt])
  @@map("saved_view")
}

model Attachment {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  entity      String
  entityId    String    @map("entity_id") @db.Uuid
  filename    String
  contentType String    @map("content_type")
  size        Int
  objectKey   String    @unique @map("object_key")
  uploadedBy  String    @map("uploaded_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  deletedAt   DateTime? @map("deleted_at")

  tenant      Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User                    @relation(fields: [uploadedBy], references: [id], onDelete: Restrict)
  ocrJobs     PurchaseInvoiceOcrJob[]
  bankImports BankStatementImport[]

  @@index([tenantId])
  @@index([tenantId, entity, entityId])
  @@index([tenantId, deletedAt])
  @@map("attachment")
}

model PeriodClose {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  module        String
  closedThrough DateTime @map("closed_through")
  closedBy      String   @map("closed_by") @db.Uuid
  reason        String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation("PeriodCloseClosedBy", fields: [closedBy], references: [id], onDelete: Restrict)

  @@unique([tenantId, module])
  @@index([tenantId])
  @@map("period_close")
}

model IdempotencyKey {
  tenantId     String   @map("tenant_id") @db.Uuid
  key          String   @db.Uuid
  resourceType String   @map("resource_type")
  resourceId   String   @map("resource_id") @db.Uuid
  responseBody Json     @map("response_body")
  statusCode   Int      @default(200) @map("status_code")
  createdAt    DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, key])
  @@index([tenantId, createdAt])
  @@map("idempotency_key")
}

model DevicePushToken {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  token      String   @unique
  platform   String
  deviceName String?  @map("device_name")
  createdAt  DateTime @default(now()) @map("created_at")
  lastUsedAt DateTime @default(now()) @map("last_used_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@map("device_push_token")
}

model TenantDeletionLog {
  id         String   @id @default(uuid()) @db.Uuid
  tenantSlug String
  tenantName String
  deletedBy  String   @db.Uuid
  deletedAt  DateTime @default(now())
  metadata   Json

  @@map("tenant_deletion_log")
}

model BillingEvent {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String?   @map("tenant_id") @db.Uuid
  stripeEventId   String    @unique @map("stripe_event_id")
  type            String
  payload         Json
  processedAt     DateTime? @map("processed_at")
  processingError String?   @map("processing_error")
  createdAt       DateTime  @default(now()) @map("created_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt])
  @@index([type, createdAt])
  @@map("billing_event")
}

model PlanLimitOverride {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  key       String
  value     Int
  expiresAt DateTime? @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String    @map("created_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, key])
  @@index([tenantId])
  @@map("plan_limit_override")
}

/// Global (tenant-independent) feature toggle. Managed by platform operators in
/// the super-admin "Features" page. A key absent from this table is treated as
/// OFF; the seed writes every current nav feature ON so rollout is invisible.
/// No tenantId / no RLS — global config reachable only through super-admin code.
model FeatureFlag {
  key         String   @id
  enabled     Boolean  @default(false)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")
  updatedById String?  @map("updated_by_id") @db.Uuid

  @@map("feature_flag")
}

model ApiKey {
  id          String      @id @default(uuid()) @db.Uuid
  tenantId    String      @map("tenant_id") @db.Uuid
  name        String
  keyPrefix   String      @unique @map("key_prefix")
  keyHash     String      @map("key_hash")
  scope       ApiKeyScope @default(read)
  lastUsedAt  DateTime?   @map("last_used_at")
  revokedAt   DateTime?   @map("revoked_at")
  expiresAt   DateTime?   @map("expires_at")
  createdAt   DateTime    @default(now()) @map("created_at")
  createdById String      @map("created_by_id") @db.Uuid

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy User   @relation("ApiKeyCreatedBy", fields: [createdById], references: [id])

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([keyPrefix])
  @@map("api_key")
}

