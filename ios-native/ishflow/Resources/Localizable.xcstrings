    "onboarding.demo.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We can populate your workspace with sample customers, products and invoices so you can explore. You can wipe it any time from Settings."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мы заполним пространство примерами клиентов, товаров и счетов — посмотрите, как это работает. Удалить можно в любое время."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çalışma alanını örnek müşteriler, ürünler ve faturalarla doldurabiliriz. İstediğin zaman ayarlardan silebilirsin."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ish joyingizni namuna mijozlar, mahsulotlar va hisob-fakturalar bilan to'ldirishimiz mumkin. Bularni istalgan vaqt Sozlamalardan o'chirishingiz mumkin."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Жумушканаңызды үлгү кардарлар, товарлар жана эсеп-фактуралар менен толтура алабыз. Аларды каалаган убакта Жөндөөлөрдөн өчүрсөңүз болот."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "We can populate your workspace with sample customers, products and invoices so you can explore. You can wipe it any time from Settings."
          }
        },
