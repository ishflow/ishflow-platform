    "onboarding.welcome.page1.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Manage invoices, stock and customers wherever you are."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Управляй счетами, складом и клиентами в любом месте."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faturalarını, stoğunu ve müşterilerini her yerden yönet."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Qayerda bo'lishingizdan qat'i nazar, hisob-fakturalar, zaxira va mijozlarni boshqaring."
          }
        },
        "ky": {
          "stringUnit": {
            "state": "translated",
            "value": "Каяктасаңыз да эсеп-фактураларды, калдыкты жана кардарларды башкарыңыз."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Manage invoices, stock and customers wherever you are."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
