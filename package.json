{
  "name": "ishflow",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:mcp": "node packages/mcp-tools/scripts/check-no-bypass.mjs",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "db:push": "dotenv -e .env.local -- prisma db push",
    "db:migrate": "dotenv -e .env.local -- prisma migrate dev",
    "db:deploy": "dotenv -e .env.local -- prisma migrate deploy",
    "db:studio": "dotenv -e .env.local -- prisma studio --port 5556",
    "db:seed": "dotenv -e .env.local -- tsx prisma/seed.ts",
    "db:reset": "dotenv -e .env.local -- prisma migrate reset",
    "db:backfill-owners": "dotenv -e .env.local -- tsx scripts/backfill-tenant-owners.ts",
    "db:backfill-chief-accountants": "dotenv -e .env.local -- tsx scripts/backfill-chief-accountants.ts",
    "env:check": "tsx scripts/env-check.ts",
    "test:e2e": "playwright test",
    "audit:perf": "tsx scripts/perf/run-audit.ts",
    "prepare": "husky",
    "generate": "tsx scripts/generate.ts",
    "generate:mcp": "dotenv -e .env.local -- tsx scripts/generate-mcp-tools.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.77",
    "@aws-sdk/client-s3": "^3.1031.0",
    "@aws-sdk/s3-request-presigner": "^3.1031.0",
    "@base-ui/react": "^1.4.0",
    "@clerk/localizations": "^4.6.8",
    "@clerk/nextjs": "^6.39.5",
    "@clerk/themes": "^2.4.57",
    "@hookform/resolvers": "^5.2.2",
    "@ishflow/mcp-tools": "workspace:*",
    "@ishflow/mobile-api-contract": "workspace:*",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@prisma/client": "^5.22.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.0.4",
    "@tanstack/react-table": "^8.21.3",
    "@types/bcrypt": "^6.0.0",
    "ai": "^6.0.180",
    "bcrypt": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^5.8.0",
    "framer-motion": "^12.38.0",
    "jose": "^6.2.2",
    "lucide-react": "^1.8.0",
    "mathjs": "^13.2.3",
    "next": "16.2.7",
    "next-intl": "^4.9.1",
    "next-mdx-remote": "^6.0.0",
    "next-themes": "^0.4.6",
    "papaparse": "^5.5.3",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.18.0",
    "react": "19.2.4",
    "react-day-picker": "^9.14.0",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.72.1",
    "recharts": "3.8.0",
    "resend": "^4.8.0",
    "shadcn": "^4.2.0",
    "sonner": "^2.0.7",
    "stripe": "^17.7.0",
    "svix": "^1.90.0",
    "tailwind-merge": "^3.5.0",
    "three": "^0.169.0",
    "tw-animate-css": "^1.4.0",
    "xlsx": "~0.18.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@biomejs/biome": "^1.9.4",
    "@clerk/types": "4.101.21",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@commitlint/types": "^19.8.1",
    "@faker-js/faker": "^10.4.0",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.184.1",
    "@vitest/ui": "^2.1.9",
    "chrome-launcher": "^1.2.1",
    "dotenv": "^16.6.1",
    "dotenv-cli": "^7.4.4",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "lighthouse": "^12.8.2",
    "lint-staged": "^15.5.2",
    "prisma": "^5.22.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^2.1.9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma"
    ]
  }
}
